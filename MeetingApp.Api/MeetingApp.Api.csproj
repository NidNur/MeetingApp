<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>3142a280-20b0-4461-bab9-5e8dc03bed51</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MailKit" Version="4.17.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.14" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.14" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.14">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Swashbuckle.AspNetCore.SwaggerUI" Version="10.3.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MeetingApp.Context\MeetingApp.Context.csproj" />
    <ProjectReference Include="..\MeetingApp.Model\MeetingApp.Model.csproj" />
  </ItemGroup>

  <Target Name="PublishAngularFrontend" AfterTargets="ComputeFilesToPublish"
          Condition="'$(PublishFrontend)' == 'true'">
    <PropertyGroup>
      <FrontendDirectory>$(MSBuildProjectDirectory)/../MeetingApp.Web/</FrontendDirectory>
      <FrontendOutput>$(FrontendDirectory)dist/meeting-app/browser/</FrontendOutput>
      <FrontendNpmCommand Condition="$([MSBuild]::IsOSPlatform('Windows'))">npm.cmd</FrontendNpmCommand>
      <FrontendNpmCommand Condition="'$(FrontendNpmCommand)' == ''">npm</FrontendNpmCommand>
    </PropertyGroup>
    <Exec WorkingDirectory="$(FrontendDirectory)" Command="$(FrontendNpmCommand) ci" />
    <Exec WorkingDirectory="$(FrontendDirectory)" Command="$(FrontendNpmCommand) run build -- --configuration production" />
    <ItemGroup>
      <FrontendFiles Include="$(FrontendOutput)**/*" />
      <ResolvedFileToPublish Include="@(FrontendFiles)" Exclude="@(ResolvedFileToPublish)">
        <RelativePath>wwwroot/%(FrontendFiles.RecursiveDir)%(FrontendFiles.Filename)%(FrontendFiles.Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

</Project>
