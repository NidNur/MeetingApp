<?xml version="1.0" encoding="utf-8"?>
<Project>
  <PropertyGroup>
    <WebPublishMethod>FileSystem</WebPublishMethod>
    <PublishProvider>FileSystem</PublishProvider>
    <LastUsedBuildConfiguration>Release</LastUsedBuildConfiguration>
    <DemoPublishId Condition="'$(DemoPublishId)' == ''">$([System.Guid]::NewGuid().ToString('N'))</DemoPublishId>
    <PublishDir>$(MSBuildProjectDirectory)\..\artifacts\demo\folder-$(DemoPublishId)\site\</PublishDir>
    <publishUrl>$(PublishDir)</publishUrl>
    <DeleteExistingFiles>false</DeleteExistingFiles>
    <LaunchSiteAfterPublish>false</LaunchSiteAfterPublish>
    <PublishFrontend>true</PublishFrontend>
    <EnvironmentName>Production</EnvironmentName>
    <SelfContained>false</SelfContained>
    <UseAppHost>false</UseAppHost>
  </PropertyGroup>
</Project>
