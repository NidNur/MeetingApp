{
  "Smtp": {
    "Host": "127.0.0.1",
    "Port": 1025,
    "Security": "StartTls",
    "FromAddress": "noreply@meetingapp.test",
    "FromName": "MeetingApp"
  },
  "EmailDelivery": {
    "Enabled": true,
    "PollIntervalSeconds": 5,
    "BatchSize": 20,
    "RetryDelaySeconds": 30
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "MeetingCleanup": {
    "Enabled": true,
    "PollIntervalSeconds": 60,
    "RetentionHours": 24,
    "BatchSize": 100
  },
  "Jwt": {
    "Issuer": "MeetingApp.Api",
    "Audience": "MeetingApp.Web",
    "ExpirationMinutes": 30
  }
}
