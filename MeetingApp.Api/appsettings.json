{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "MeetingCleanup": {
    "Enabled": true,
    "PollIntervalSeconds": 60,
    "RetentionHours": 24,
    "BatchSize": 100
  },
  "Jwt": {
    "Issuer": "MeetingApp.Api",
    "Audience": "MeetingApp.Web",
    "ExpirationMinutes": 30
  }
}
